# Couvertures du shelf (script `pnpm covers`). Optionnel : seuls les films
# passent par TMDB, mangas et livres passent par Kitsu et Open Library.
NUXT_TMDB_API_KEY=

# Activite GitHub de la sidebar. Personal Access Token *classique* avec le
# scope `read:user` (les jetons fine-grained couvrent mal les donnees de profil).
# Sans cette valeur, /api/github-activity renvoie null et le widget garde son
# etat « bientot disponible » : le dev et le build fonctionnent sans jeton.
NUXT_GITHUB_TOKEN=
